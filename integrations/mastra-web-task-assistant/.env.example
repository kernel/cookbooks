# Pull real values from ~/AGENTS.md (do not commit real secrets).
KERNEL_API_KEY=your-kernel-api-key

# Default model provider (openai/gpt-5.6-terra)
OPENAI_API_KEY=your-openai-key

# Optional
MASTRA_MODEL=openai/gpt-5.6-terra
# Required only when MASTRA_MODEL uses an anthropic/ model
# ANTHROPIC_API_KEY=your-anthropic-key
MASTRA_STORAGE_URL=file:./mastra.db
