# --- Kernel -----------------------------------------------------------------
KERNEL_API_KEY=your_kernel_api_key
# Vaults are project-owned; the browser and vault must share this project.
KERNEL_PROJECT_ID=your_project_id

# --- Vault / payments --------------------------------------------------------
# One vault per end user. Created if missing.
VAULT_NAME=global-checkout-demo
# Wallet item key inside the vault. Connect it ONCE, outside this script (see README).
WALLET_KEY=agentcard-wallet
# agentcard | link
PAYMENT_PROVIDER=agentcard
# Name shown on the approval screen (AgentCard) / merchant_name (Link).
MERCHANT_NAME=Example Shop

# --- Storefronts (same SKU, one URL per region) -------------------------------
STOREFRONT_US_URL=https://shop.example.com/products/notebook
STOREFRONT_EU_URL=https://shop.example.eu/products/notebook
STOREFRONT_AP_URL=https://shop.example.sg/products/notebook

# --- Optional: Kernel proxy IDs so the exit IP matches each market -----------
# kernel proxies create --type residential --country US --name "US Residential" -o json
PROXY_ID_US=
PROXY_ID_EU=
PROXY_ID_AP=

# --- Customer fields (from the end user, never invented by the agent) --------
CHECKOUT_EMAIL=buyer@example.com
CHECKOUT_BILLING_NAME=Ada Lovelace
CHECKOUT_POSTAL_CODE=94102

# --- Behaviour ---------------------------------------------------------------
# true = price-check only; no card item, no checkout.
DRY_RUN=true
# true = skip the interactive "Buy this?" prompt. CI only.
AUTO_CONFIRM=false
# true = print provider action URLs to this terminal (you are the trusted human).
# false = print the `kernel vaults items get ... --open` command instead.
PRINT_ACTION_URLS=false
BROWSER_TIMEOUT_SECONDS=1800
