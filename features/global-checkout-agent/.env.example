# --- Kernel -----------------------------------------------------------------
KERNEL_API_KEY=your_kernel_api_key
# Vaults are project-owned; the browser and vault must share this project.
KERNEL_PROJECT_ID=your_project_id

# --- Vault / payments --------------------------------------------------------
# One vault per end user. Created if missing.
VAULT_NAME=global-checkout-demo
# Wallet item key inside the vault. Connect it ONCE, outside this script (see README).
WALLET_KEY=link-wallet
# link | agentcard
PAYMENT_PROVIDER=link
# Link only: the payment method the user chose (printed by the script if unset
# and the wallet has more than one).
LINK_PAYMENT_METHOD_ID=
# How long to wait for the user to approve the spend request.
APPROVAL_TIMEOUT_SECONDS=600

# --- Storefront --------------------------------------------------------------
# Reference storefront: Kernel's public $1.00 Stripe Payment Link. Stripe Adaptive
# Pricing quotes each region in its local currency, so prices differ by region.
# A full run (DRY_RUN=false) is a REAL $1.00 charge to Kernel Technologies, Inc.
STOREFRONT_URL=https://buy.stripe.com/28E5kw7DtgKXdLqgiY53O00
# Optional per-region overrides if your storefront uses regional domains.
STOREFRONT_US_URL=
STOREFRONT_EU_URL=
STOREFRONT_AP_URL=
# The merchant you expect. The run stops if the checkout names anyone else.
MERCHANT_NAME="Kernel Technologies, Inc."
# Quotes are compared in this currency at ECB reference rates (frankfurter.dev).
COMPARE_CURRENCY=usd

# --- Optional: Kernel proxy IDs so the exit IP matches each market -----------
# kernel proxies create --type residential --country US --name "US Residential" -o json
PROXY_ID_US=
PROXY_ID_EU=
PROXY_ID_AP=

# --- Customer fields (from the end user, never invented by the agent) --------
# If CHECKOUT_EMAIL has a Link account, Stripe shows a Link sign-in prompt (and may
# text the account holder a code). The script dismisses it and pays with the card
# form; an address without a Link account avoids the prompt entirely.
CHECKOUT_EMAIL=buyer@example.com
CHECKOUT_BILLING_NAME="Ada Lovelace"
CHECKOUT_BILLING_COUNTRY=US
CHECKOUT_POSTAL_CODE=94102

# --- Behaviour ---------------------------------------------------------------
# true = price-check only; no card item, no checkout, no charge.
DRY_RUN=true
# true = skip the interactive "Buy this?" prompt. CI only.
AUTO_CONFIRM=false
# true = print provider action URLs to this terminal (you are the trusted human).
# false = print the `kernel vaults items get ... --open` command instead.
PRINT_ACTION_URLS=false
# true = print the winning browser's live view URL before checkout.
PRINT_LIVE_VIEW=false
BROWSER_TIMEOUT_SECONDS=1800
